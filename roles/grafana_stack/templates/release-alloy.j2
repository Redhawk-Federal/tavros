apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: tavros-alloy
  namespace: {{ grafana_stack.namespace }}
spec:
  targetNamespace: {{ grafana_stack.namespace }}
  releaseName: tavros-alloy
  dependsOn:
    - name: tavros
    - name: tavros-loki
  interval: 30m
  timeout: 10m
  chart:
    spec:
      # https://github.com/grafana/alloy/tree/helm-chart/1.13.0/operations/helm/charts/alloy
      chart: alloy
      version: 1.13.0
      sourceRef:
        kind: HelmRepository
        name: grafana
        namespace: flux-system
  install:
    remediation:
      retries: 3
  upgrade:
    remediation:
      retries: 3
  values:
    fullnameOverride: tavros-alloy
    controller:
      type: daemonset
      # A log collector belongs on every node, control plane included (kOps
      # and kind taint it NoSchedule), or kube-apiserver/etcd logs are lost.
      tolerations:
        - operator: Exists
    serviceMonitor:
      enabled: true
    alloy:
      enableReporting: false
      resources:
{{ grafana_stack.resources.alloy | to_nice_yaml(indent=2) | indent(8, true) }}
      extraEnv:
        - name: NODE_NAME
          valueFrom:
            fieldRef:
              fieldPath: spec.nodeName
      configMap:
        create: false
        name: tavros-alloy-config
        key: config.alloy
