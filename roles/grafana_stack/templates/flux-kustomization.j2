apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: grafana-stack
  namespace: flux-system
spec:
  interval: 5m0s
  path: ./platform/grafana-stack
  sourceRef:
    kind: GitRepository
    name: tavros
  prune: true
  timeout: 10m0s
  healthChecks:
    - apiVersion: helm.toolkit.fluxcd.io/v2
      kind: HelmRelease
      name: tavros
      namespace: {{ grafana_stack.namespace }}
---
# The monitors need the prometheus-operator CRDs that the HelmRelease above
# installs, so they reconcile only after it is healthy.
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: grafana-stack-monitors
  namespace: flux-system
spec:
  dependsOn:
    - name: grafana-stack
  interval: 5m0s
  path: ./platform/grafana-stack-monitors
  sourceRef:
    kind: GitRepository
    name: tavros
  prune: true
  timeout: 5m0s
