apiVersion: v1
kind: Secret
metadata:
  name: tavros-grafana
  namespace: {{ grafana_stack.namespace }}
type: Opaque
stringData:
  admin-user: admin
  admin-password: "{{ grafana_stack.grafana.admin_password }}"
  oauth-client-secret: "{{ grafana_stack.keycloak.client_secret }}"
{% if grafana_stack.alertmanager.slack_webhook %}
---
apiVersion: v1
kind: Secret
metadata:
  name: tavros-alertmanager-slack
  namespace: {{ grafana_stack.namespace }}
type: Opaque
stringData:
  url: "{{ grafana_stack.alertmanager.slack_webhook }}"
{% endif %}
