apiVersion: apps/v1
kind: Deployment
metadata:
  name: git-shell
  namespace: gitea
  labels:
    app: git
spec:
  replicas: 1
  selector:
    matchLabels:
      app: git
  template:
    metadata:
      labels:
        app: git
    spec:
      containers:
      - name: git
        image: alpine/git:2.54.0
        command: [ "/bin/sh", "-c" ]
        args: [ "while true; do sleep 30; done;" ]