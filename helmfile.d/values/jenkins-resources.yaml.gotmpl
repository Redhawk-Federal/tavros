{{- /*
  Ports roles/jenkins/files/jenkins.yaml and templates/{ingress,
  configmap-jenkins-config,keycloakclient,keycloakuser-jenkins-ci,
  secret-artifacts-registry,secret-gitea-creds,secret-keycloak-creds}.j2.
  The jenkins-operator's own install (CRD + all-in-one.yaml Deployment/RBAC)
  is handled by releases/jenkins.yaml's presync hook / vendored file - see
  the judgment-call note there.

  NOT ported: roles/jenkins/tasks/gitea_setup.yaml (imperative Gitea API
  calls creating the jenkins-ci user / org-owner membership - explicitly
  out of scope, see README). This IS the release whose Gitea webhook
  (configured by that same out-of-scope task) is meant to drive the day-2
  `helmfile diff`/`apply` loop - see examples/Jenkinsfile.stage.
*/ -}}
{{- $cfqdn := .Environment.Values.cluster_fqdn }}
{{- $adminEmail := .Environment.Values.cluster_admin_email }}
{{- $jenkins := .Environment.Values.jenkins }}
{{- $kong := .Environment.Values.kong }}
manifests:
  - apiVersion: jenkins.io/v1alpha2
    kind: Jenkins
    metadata:
      name: tavros
      namespace: jenkins
    spec:
      groovyScripts:
        configurations: []
        secret:
          name: ""
      jenkinsAPISettings:
        authorizationStrategy: createUser
      master:
        disableCSRFProtection: false
        containers:
          - name: jenkins-master
            image: jenkins/jenkins:2.452.3-lts-jdk17
            imagePullPolicy: IfNotPresent
            resources:
              limits:
                cpu: 1000m
                memory: 2Gi
              requests:
                cpu: 500m
                memory: 1Gi
            livenessProbe:
              failureThreshold: 30
              httpGet:
                path: /login
                port: http
                scheme: HTTP
              initialDelaySeconds: 600
              periodSeconds: 10
              successThreshold: 1
              timeoutSeconds: 5
            readinessProbe:
              failureThreshold: 5
              httpGet:
                path: /login
                port: http
                scheme: HTTP
              initialDelaySeconds: 30
              periodSeconds: 10
              successThreshold: 1
              timeoutSeconds: 1
        basePlugins:
          - name: kubernetes
            version: "4029.v5712230ccb_f8"
          - name: workflow-job
            version: "1326.ve643e00e9220"
          - name: workflow-aggregator
            version: "581.v0c46fa_697ffd"
          - name: git
            version: "5.2.0"
          - name: job-dsl
            version: "1.84"
          - name: configuration-as-code
            version: "1670.v564dc8b_982d0"
          - name: kubernetes-credentials-provider
            version: "1.211.vc236a_f5a_2f3c"
        latestPlugins: false
        plugins:
          - name: keycloak
            version: "2.3.0"
          - name: script-security
            version: "1265.va_fb_290b_4b_d34"
          - name: pipeline-model-api
            version: "2.2144.v077a_d1928a_40"
          - name: pipeline-stage-step
            version: "305.ve96d0205c1c6"
          - name: git-server
            version: "99.va_0826a_b_cdfa_d"
          - name: pipeline-model-definition
            version: "2.2144.v077a_d1928a_40"
          - name: gitea
            version: "1.2.1"
          - name: build-user-vars-plugin
            version: "1.7"
          - name: junit
            version: "1189.v1b_e593637fa_e"
      configurationAsCode:
        configurations:
          - name: tavros-jenkins-config
        secret:
          name: ""

  - apiVersion: networking.k8s.io/v1
    kind: Ingress
    metadata:
      name: tavros
      namespace: jenkins
      annotations:
        cert-manager.io/cluster-issuer: tavros
        kubernetes.io/ingress.class: {{ $kong.default_ingress_class }}
        konghq.com/strip-path: "true"
        konghq.com/protocols: https
        konghq.com/https-redirect-status-code: "302"
    spec:
      rules:
        - host: ci.{{ $cfqdn }}
          http:
            paths:
              - path: /
                pathType: Prefix
                backend:
                  service:
                    name: jenkins-operator-http-tavros
                    port:
                      number: 8080
      tls:
        - hosts:
            - ci.{{ $cfqdn }}
          secretName: ci-ingress-cert

  - apiVersion: v1
    kind: ConfigMap
    metadata:
      name: tavros-jenkins-config
      namespace: jenkins
    data:
      1-casc.yaml: |
        unclassified:
          location:
            url: https://ci.{{ $cfqdn }}/
            adminAddress: {{ $adminEmail }}
          keycloakSecurityRealm:
            keycloakJson: |-
              {
                "realm": "{{ $jenkins.keycloak.realm }}",
                "auth-server-url": "https://auth.{{ $cfqdn }}/auth/",
                "ssl-required": "external",
                "resource": "jenkins",
                "public-client": true,
                "confidential-port": 0
              }
          giteaServers:
            servers:
            - credentialsId: "tavros-gitea-creds"
              displayName: "gitea"
              manageHooks: true
              serverUrl: "https://code.{{ $cfqdn }}"
          globalLibraries:
            libraries:
              - name: "tavros-library"
                defaultVersion: "v0.5"
                retriever:
                  modernSCM:
                    scm:
                      git:
                        remote: "https://github.com/MS3Inc/tavros-jenkins-libraries.git"
        jenkins:
          securityRealm: keycloak
          globalNodeProperties:
          - envVars:
              env:
              - key: TAVROS_HOST
                value: {{ $cfqdn }}
              - key: TAVROS_GIT_HOST
                value: code.{{ $cfqdn }}
              - key: TAVROS_GIT_PROVIDER
                value: gitea
              - key: TAVROS_GIT_CREDS
                value: tavros-gitea-creds
              - key: TAVROS_REG_HOST
                value: registry.{{ $cfqdn }}
              - key: TAVROS_REG_CREDS
                value: keycloak-basic-auth

        jobs:
        - script: >
            organizationFolder('Gitea Tavros Folder') {
                description("Track Tavros Gitea repositories and events")
                displayName('Gitea Tavros')
                organizations {
                }

                configure { node ->
                    node / navigators << 'org.jenkinsci.plugin.gitea.GiteaSCMNavigator' {
                        serverUrl("https://code.{{ $cfqdn }}")
                        repoOwner("tavros")
                        credentialsId("tavros-gitea-creds")
                        traits {
                            'org.jenkinsci.plugin.gitea.BranchDiscoveryTrait'() {
                                strategyId('1')
                            }
                            'org.jenkinsci.plugin.gitea.OriginPullRequestDiscoveryTrait'() {
                                strategyId('1')
                            }
                            'org.jenkinsci.plugin.gitea.ForkPullRequestDiscoveryTrait'() {
                                strategyId('1')
                                trust(class: 'org.jenkinsci.plugin.gitea.ForkPullRequestDiscoveryTrait$TrustContributors')
                            }
                        }
                    }
                }
            }
        - script: >
            pipelineJob('Quickstart - OpenAPI Project') {
              definition {
                cps {
                  sandbox(true)
                  script("""@Library("tavros-library") _

                            |openapi_quickstart()""".stripMargin())
                }
              }
            }
        - script: >
            pipelineJob('Quickstart - Camel Web Service Project') {
              definition {
                cps {
                  sandbox(true)
                  script("""@Library("tavros-library") _

                            |camelwebservice_quickstart()""".stripMargin())
                }
              }
            }

  - apiVersion: keycloak.org/v1alpha1
    kind: KeycloakClient
    metadata:
      name: tavros-jenkins
      namespace: keycloak
      labels:
        client: jenkins
    spec:
      realmSelector:
        matchLabels:
          realm: {{ $jenkins.keycloak.realm }}
      client:
        clientId: jenkins
        rootUrl: https://ci.{{ $cfqdn }}
        enabled: true
        clientAuthenticatorType: client-secret
        redirectUris:
          - https://ci.{{ $cfqdn }}/*
        standardFlowEnabled: true
        implicitFlowEnabled: false
        directAccessGrantsEnabled: true
        serviceAccountsEnabled: false
        publicClient: true
        protocol: openid-connect
        defaultClientScopes:
          - "email"
          - "profile"
          - "roles"
          - "offline_access"
          - "web-origins"
          - "phone"
          - "microprofile-jwt"
          - "address"

  - apiVersion: keycloak.org/v1alpha1
    kind: KeycloakUser
    metadata:
      name: tavros-jenkins-ci
      namespace: keycloak
    spec:
      realmSelector:
        matchLabels:
          realm: {{ $jenkins.keycloak.realm }}
      user:
        username: jenkins-ci
        enabled: true
        emailVerified: true
        credentials:
          - type: password
            value: "{{ $jenkins.keycloak.password }}"
            temporary: false
        clientRoles:
          nexus:
            - "developer"
        realmRoles:
          - "default-roles-{{ $jenkins.keycloak.realm }}"

  - apiVersion: v1
    kind: Secret
    metadata:
      name: tavros-artifacts-registry
      namespace: jenkins
    type: kubernetes.io/dockerconfigjson
    stringData:
      .dockerconfigjson: |-
        {"auths":{"registry.{{ $cfqdn }}":{"auth":"{{ printf "jenkins-ci:%s" $jenkins.keycloak.password | b64enc }}"}}}

  - apiVersion: v1
    kind: Secret
    metadata:
      name: tavros-gitea-creds
      namespace: jenkins
      labels:
        jenkins.io/credentials-type: "usernamePassword"
      annotations:
        jenkins.io/credentials-description: "Jenkins' Gitea HTTP Credentials"
    type: Opaque
    stringData:
      username: "jenkins-ci"
      password: "{{ $jenkins.gitea.password }}"

  - apiVersion: v1
    kind: Secret
    metadata:
      name: keycloak-basic-auth
      namespace: jenkins
      labels:
        jenkins.io/credentials-type: "usernamePassword"
      annotations:
        jenkins.io/credentials-description: "Jenkins' Keycloak Credentials"
    type: Opaque
    stringData:
      username: "jenkins-ci"
      password: "{{ $jenkins.keycloak.password }}"

manifestFiles:
  - jenkins/all-in-one.yaml
