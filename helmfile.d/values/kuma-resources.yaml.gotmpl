{{- /*
  Ports roles/kuma/templates/mesh.j2 and traffictrace.j2, one Mesh (+
  TrafficTrace, if enabled) per entry in .Environment.Values.kuma.meshes.
*/ -}}
{{- $jaegerEnabled := .Environment.Values.jaeger.enabled }}
manifests:
{{- range $mesh := .Environment.Values.kuma.meshes }}
  - apiVersion: kuma.io/v1alpha1
    kind: Mesh
    metadata:
      name: {{ $mesh.name }}
      namespace: kuma-system
    spec:
      {{- if and $mesh.mtls $mesh.mtls.enabled }}
      mtls:
        enabledBackend: ca-1
        backends:
          - name: ca-1
            type: builtin
            dpCert:
              rotation:
                expiration: 1d
            conf:
              caCert:
                RSAbits: 2048
                expiration: 10y
      {{- end }}
      {{- if and $mesh.traffictrace $mesh.traffictrace.enabled $jaegerEnabled }}
      tracing:
        defaultBackend: jaeger-collector
        backends:
          - name: jaeger-collector
            type: zipkin
            sampling: 100
            conf:
              url: http://tavros-collector.jaeger.svc.cluster.local:9411/api/v2/spans
      {{- end }}

  {{- if and $mesh.traffictrace $mesh.traffictrace.enabled $jaegerEnabled }}
  - apiVersion: kuma.io/v1alpha1
    kind: TrafficTrace
    mesh: {{ $mesh.name }}
    metadata:
      name: {{ $mesh.name }}-trace-all-traffic
      namespace: kuma-system
    spec:
      selectors:
        - match:
            kuma.io/service: "*"
      conf:
        backend: jaeger-collector
  {{- end }}
{{- end }}
