---
# kong v2.52.0 (https://charts.konghq.com), one release set per kong.instances entry.
# labels (not values:) carry the instance name: inline `values:` map entries
# aren't visible to a later .gotmpl in the same list on this helmfile version.
{{- $kong := .Environment.Values.kong }}
releases:
  - name: kong-ee-creds
    namespace: kong
    createNamespace: true
    chart: ../charts/raw-manifests
    values:
      - ../values/kong-ee-creds.yaml.gotmpl

{{- range $inst := $kong.instances }}

  - name: kong-{{ $inst.name }}-resources
    namespace: kong
    chart: ../charts/raw-manifests
    labels:
      instance: {{ $inst.name }}
    # needs cert-manager-resources (ClusterIssuer) and, if ee.enabled, keycloak-resources (realm).
    # needs: doesn't cross helmfiles: includes, so helmfile.yaml's include order enforces this instead.
    needs:
      - kong/kong-ee-creds
    values:
      - ../values/kong-resources.yaml.gotmpl

  {{- if $inst.hybrid }}

  - name: kong-{{ $inst.name }}-cp
    namespace: kong
    chart: kong/kong
    version: 2.52.0
    labels:
      instance: {{ $inst.name }}
      role: control_plane
    needs:
      - kong/kong-{{ $inst.name }}-resources
    values:
      - ../values/kong-release.yaml.gotmpl

  - name: kong-{{ $inst.name }}-dp
    namespace: kong
    chart: kong/kong
    version: 2.52.0
    labels:
      instance: {{ $inst.name }}
      role: data_plane
    needs:
      - kong/kong-{{ $inst.name }}-cp
    values:
      - ../values/kong-release.yaml.gotmpl

  {{- else }}

  - name: kong-{{ $inst.name }}
    namespace: kong
    chart: kong/kong
    version: 2.52.0
    labels:
      instance: {{ $inst.name }}
      role: none
    needs:
      - kong/kong-{{ $inst.name }}-resources
    values:
      - ../values/kong-release.yaml.gotmpl

  {{- end }}
{{- end }}
