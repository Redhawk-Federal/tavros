{{- $cfqdn := .Environment.Values.cluster_fqdn }}
{{- $kong := .Environment.Values.kong }}
manifests:
  - apiVersion: cert-manager.io/v1
    kind: ClusterIssuer
    metadata:
      name: tavros-selfsigned-ca
      namespace: cert-manager
    spec:
      selfSigned: {}

  - apiVersion: cert-manager.io/v1
    kind: Certificate
    metadata:
      name: tavros-ca-root
      namespace: cert-manager
    spec:
      isCA: true
      commonName: tavros-ca
      secretName: tavros-ca-root
      privateKey:
        algorithm: ECDSA
        size: 256
      issuerRef:
        name: tavros-selfsigned-ca
        kind: ClusterIssuer
        group: cert-manager.io

  - apiVersion: cert-manager.io/v1
    kind: ClusterIssuer
    metadata:
      name: tavros-ca
      namespace: cert-manager
    spec:
      ca:
        secretName: tavros-ca-root

  - apiVersion: cert-manager.io/v1
    kind: ClusterIssuer
    metadata:
      name: tavros
      namespace: cert-manager
    spec:
      acme:
        # use the LE staging server (not this URL) for non-prod clusters
        email: {{ .Environment.Values.cluster_admin_email }}
        server: https://acme-v02.api.letsencrypt.org/directory
        preferredChain: "ISRG Root X1"
        privateKeySecretRef:
          name: tavros-issuer-account-key
        solvers:
        {{- range $kong.instances }}
          - selector:
              dnsZones:
                - "{{ .name }}.{{ $cfqdn }}"
                {{- if eq .ingress_class $kong.default_ingress_class }}
                - "{{ $cfqdn }}"
                - "apps.{{ $cfqdn }}"
                {{- else }}
                - "{{ .ingress_class }}.{{ $cfqdn }}"
                - "apps.{{ .ingress_class }}.{{ $cfqdn }}"
                {{- end }}
            http01:
              ingress:
                class: {{ .ingress_class }}
        {{- end }}
