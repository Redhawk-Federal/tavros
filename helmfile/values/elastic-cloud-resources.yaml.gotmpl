{{- /* Kibana saved-objects import (roles/elastic_cloud/tasks/config_kibana.yaml) is not ported */ -}}
{{- $cfqdn := .Environment.Values.cluster_fqdn }}
{{- $ec := .Environment.Values.elastic_cloud }}
{{- $kong := .Environment.Values.kong }}
{{- $jaeger := .Environment.Values.jaeger }}
{{- $kopsEnabled := false }}
manifests:
  - apiVersion: elasticsearch.k8s.elastic.co/v1
    kind: Elasticsearch
    metadata:
      name: tavros
      namespace: elastic-system
    spec:
      version: 8.15.3
      http:
        tls:
          selfSignedCertificate:
            disabled: true
      auth:
        roles:
          - secretName: tavros-beats-role-override
      nodeSets:
        - name: default
          count: 3
          volumeClaimTemplates:
            - metadata:
                name: elasticsearch-data
              spec:
                accessModes:
                  - ReadWriteOnce
                resources:
                  requests:
                    storage: 50Gi
                storageClassName: default
          {{- if $ec.ee.enabled }}
          config:
            xpack.security.authc.token.enabled: true
            xpack.security.authc.realms.oidc.oidc1:
              order: 2
              rp.client_id: "elastic-cloud"
              rp.response_type: code
              rp.redirect_uri: "https://kibana.{{ $cfqdn }}/api/security/oidc/callback"
              rp.post_logout_redirect_uri: "https://kibana.{{ $cfqdn }}"
              op.issuer: "https://auth.{{ $cfqdn }}/auth/realms/{{ $ec.ee.keycloak.realm }}"
              op.authorization_endpoint: "https://auth.{{ $cfqdn }}/auth/realms/{{ $ec.ee.keycloak.realm }}/protocol/openid-connect/auth"
              op.token_endpoint: "https://auth.{{ $cfqdn }}/auth/realms/{{ $ec.ee.keycloak.realm }}/protocol/openid-connect/token"
              op.jwkset_path: "https://auth.{{ $cfqdn }}/auth/realms/{{ $ec.ee.keycloak.realm }}/protocol/openid-connect/certs"
              op.userinfo_endpoint: "https://auth.{{ $cfqdn }}/auth/realms/{{ $ec.ee.keycloak.realm }}/protocol/openid-connect/userinfo"
              op.endsession_endpoint: "https://auth.{{ $cfqdn }}/auth/realms/{{ $ec.ee.keycloak.realm }}/protocol/openid-connect/logout"
              claims.principal: sub
              claims.name: name
              claims.mail: email
              claims.groups: groups
          {{- end }}
          podTemplate:
            spec:
              containers:
                - name: elasticsearch
                  env:
                    - name: ES_JAVA_OPTS
                      value: -Xms2g -Xmx2g
                  resources:
                    requests:
                      memory: 4Gi
                    limits:
                      memory: 4Gi
              initContainers:
                - name: sysctl
                  securityContext:
                    privileged: true
                  command: ["sh", "-c", "sysctl -w vm.max_map_count=262144"]
                {{- if $ec.ee.enabled }}
                - name: ee-setup
                  command:
                    - "sh"
                    - "-c"
                    - |
                      echo '{{ $ec.ee.keycloak.client_secret }}' | bin/elasticsearch-keystore add xpack.security.authc.realms.oidc.oidc1.rp.client_secret -x -f
                {{- end }}

  - apiVersion: kibana.k8s.elastic.co/v1
    kind: Kibana
    metadata:
      name: tavros
      namespace: elastic-system
    spec:
      version: 8.15.3
      count: 1
      elasticsearchRef:
        name: tavros
      http:
        service:
          metadata:
            annotations:
              konghq.com/protocol: https
      {{- if $ec.ee.enabled }}
      config:
        xpack.security.authc.providers:
          oidc.oidc1:
            order: 0
            realm: "oidc1"
          basic.basic1:
            order: 1
            icon: "logoElasticsearch"
      {{- end }}

  - apiVersion: networking.k8s.io/v1
    kind: Ingress
    metadata:
      name: tavros
      namespace: elastic-system
      annotations:
        cert-manager.io/cluster-issuer: tavros
        kubernetes.io/ingress.class: {{ $kong.default_ingress_class }}
        konghq.com/strip-path: "true"
        konghq.com/protocols: https
        konghq.com/https-redirect-status-code: "302"
    spec:
      rules:
        - host: kibana.{{ $cfqdn }}
          http:
            paths:
              - path: /
                pathType: ImplementationSpecific
                backend:
                  service:
                    name: tavros-kb-http
                    port:
                      number: 5601
      tls:
        - hosts:
            - kibana.{{ $cfqdn }}
          secretName: elastic-cloud-ingress-cert

  {{- if $ec.ee.enabled }}
  - apiVersion: keycloak.org/v1alpha1
    kind: KeycloakClient
    metadata:
      name: tavros-elastic-cloud
      namespace: keycloak
      labels:
        client: elastic-cloud
    spec:
      realmSelector:
        matchLabels:
          realm: {{ $ec.ee.keycloak.realm }}
      client:
        clientId: elastic-cloud
        secret: "{{ $ec.ee.keycloak.client_secret }}"
        clientAuthenticatorType: client-secret
        protocol: openid-connect
        redirectUris:
          - "https://kibana.{{ $cfqdn }}/*"
        standardFlowEnabled: true
        enabled: true
        protocolMappers:
          - name: groups
            protocol: openid-connect
            protocolMapper: "oidc-usermodel-client-role-mapper"
            config:
              id.token.claim: "true"
              claim.name: groups
              multivalued: "true"
              userinfo.token.claim: "true"
              jsonType.label: string
              access.token.claim: "false"
              usermodel.clientRoleMapping.clientId: elastic-cloud

  {{- if $ec.ee.trial }}
  - apiVersion: v1
    kind: Secret
    metadata:
      name: eck-license
      namespace: elastic-system
      labels:
        license.k8s.elastic.co/type: enterprise_trial
      annotations:
        elastic.co/eula: accepted
  {{- else }}
  - apiVersion: v1
    kind: Secret
    metadata:
      name: eck-license
      namespace: elastic-system
      labels:
        license.k8s.elastic.co/scope: operator
    type: Opaque
    stringData:
      license: "{{ $ec.ee.license }}"
  {{- end }}
  {{- end }}

  {{- if $jaeger.enabled }}
  - apiVersion: v1
    kind: Secret
    metadata:
      name: tavros-init-scripts
      namespace: elastic-system
    type: Opaque
    stringData:
      jaeger.sh: |
        #!/usr/bin/env bash
        set -o nounset
        set -o errexit

        # todo: make operations idempotent
        echo "Create Role"
        curl -X POST -i --insecure -f -u elastic:$ES_PSW $ES_HOST:9200/_security/role/jaeger_writer  \
        -d '{
              "cluster": ["monitor", "manage_index_templates"],
              "indices": [
                  {
                      "names": ["tavros-jaeger-*", "tavros:jaeger-*"],
                      "privileges": ["all"],
                      "field_security": {"grant": ["*"]},
                      "allow_restricted_indices": false
                  }
              ],
              "applications": [],
              "run_as": [],
              "metadata": {},
              "transient_metadata": {"enabled": true}
          }' \
        -H 'Content-Type: application/json'

        echo "Create User"
        curl -X POST -i --insecure -f -u elastic:$ES_PSW $ES_HOST:9200/_security/user/jaeger \
        -d '{
              "password": "{{ $jaeger.es.password }}",
              "roles": ["jaeger_writer"],
              "full_name": "Jaeger User"
            }' \
        -H 'Content-Type: application/json'
      lifecycle-policies-init.sh: |
        #!/usr/bin/env bash
        set -o nounset
        set -o errexit

        echo "Create Logs ILM Policy"
        curl -X PUT -s -i --insecure -u elastic:$ES_PSW -L "$ES_HOST:9200/_ilm/policy/logs?timeout=240s&master_timeout=240s" \
        -d '{"policy":{"phases":{"hot":{"min_age":"0ms","actions":{"rollover":{"max_primary_shard_size":"50gb","max_age":"30d"}}},"delete":{"min_age":"90d","actions":{"delete":{}}}}}}' \
        -H 'Content-Type: application/json'

        echo "Create Metrics ILM Policy"
        curl -X PUT -s -i --insecure -u elastic:$ES_PSW -L "$ES_HOST:9200/_ilm/policy/metrics?timeout=240s&master_timeout=240s" \
        -d '{"policy":{"phases":{"hot":{"min_age":"0ms","actions":{"rollover":{"max_primary_shard_size":"50gb","max_age":"56h"}}},"delete":{"min_age":"7d","actions":{"delete":{}}}}}}' \
        -H 'Content-Type: application/json'

        echo "Create Heartbeat ILM Policy"
        curl -X PUT -s -i --insecure -u elastic:$ES_PSW -L "$ES_HOST:9200/_ilm/policy/heartbeat?timeout=240s&master_timeout=240s" \
        -d '{"policy":{"phases":{"hot":{"min_age":"0ms","actions":{"rollover":{"max_primary_shard_size":"50gb","max_age":"8h"}}},"delete":{"min_age":"1d","actions":{"delete":{}}}}}}' \
        -H 'Content-Type: application/json'

  - apiVersion: batch/v1
    kind: Job
    metadata:
      name: tavros-init-runner
      namespace: elastic-system
    spec:
      template:
        spec:
          containers:
            - name: fedora
              image: fedora:latest
              command:
                - "/bin/sh"
                - "-c"
                - |
                  for script in /tmp/init-scripts/*.sh; do
                    if ! bash "$script"; then exit 1; fi
                  done
              env:
                - name: ES_HOST
                  value: http://tavros-es-http.elastic-system.svc.cluster.local
                - name: ES_PSW
                  valueFrom:
                    secretKeyRef:
                      name: tavros-es-elastic-user
                      key: elastic
              volumeMounts:
                - name: init-scripts
                  mountPath: /tmp/init-scripts
          volumes:
            - name: init-scripts
              secret:
                secretName: tavros-init-scripts
                defaultMode: 0777
          restartPolicy: OnFailure
      backoffLimit: 8
  {{- end }}

manifestFiles:
  - elastic-cloud/filebeat-rbac.yaml
  - elastic-cloud/metricbeat-rbac.yaml
  - elastic-cloud/secret-beats-role-override.yaml
  - elastic-cloud/filebeat.yaml
  - elastic-cloud/heartbeat.yaml
  - elastic-cloud/metricbeat-node-exporter.yaml
  - elastic-cloud/metricbeat-kube-state-metrics.yaml
  {{- if $ec.ee.enabled }}
  - elastic-cloud/apmserver.yaml
  - elastic-cloud/daemonset-jaeger-agent.yaml
  {{- end }}
