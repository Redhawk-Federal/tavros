// Sample single-stage Jenkins pipeline showing the intended day-2 GitOps
// loop for this Helmfile port: push to the Gitea platform-manifests repo
// (this repo, or wherever helmfile/ ends up living) -> Gitea webhook
// (roles/jenkins/tasks/gitea_setup.yaml already wires a webhook per-repo;
// point one at this repo too) -> Jenkins runs `helmfile diff` on PR and
// `helmfile apply` on merge to main, all within one stage.
//
// This is illustrative only - NOT wired into .jenkins/Jenkinsfile (that
// pipeline drives kOps/Terraform cluster provisioning, a separate concern
// out of scope for this POC). Copy/adapt this stage into whatever pipeline
// watches this repo once the Gitea webhook -> Jenkins job exists. Follows
// the same `container('tavros-tools')` convention as the real
// .jenkins/Jenkinsfile so it can reuse that pod template/tool image.

pipeline {
  agent {
    kubernetes {
      label 'node'
      yamlFile '.jenkins/kubernetes.yaml'
    }
  }
  stages {
    stage('helmfile') {
      steps {
        container('tavros-tools') {
          sh 'helmfile --file helmfile/helmfile.yaml --environment prod lint'
          script {
            if (env.CHANGE_ID) {
              sh 'helmfile --file helmfile/helmfile.yaml --environment prod diff --detailed-exitcode || true'
              // post the diff as a PR comment via the Gitea API here, same
              // pattern roles/jenkins/tasks/gitea_setup.yaml uses for webhooks.
            } else if (env.BRANCH_NAME == 'main') {
              sh 'helmfile --file helmfile/helmfile.yaml --environment prod apply --skip-diff-on-install'
            }
          }
        }
      }
    }
  }
}
